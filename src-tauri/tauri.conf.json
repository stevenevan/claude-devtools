{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "claude-devtools",
  "version": "0.4.8",
  "identifier": "com.claude-devtools.app",
  "build": {
    "beforeDevCommand": "cd frontend && bun run dev",
    "devUrl": "http://127.0.0.1:9245",
    "beforeBuildCommand": "cd frontend && bun run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "claude-devtools",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
